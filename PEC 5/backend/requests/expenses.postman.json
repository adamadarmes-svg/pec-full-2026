              "raw": "{\n  \"title\": \"Compra semanal\",\n  \"amount\": 54.37,\n  \"category\": \"comida\",\n  \"date\": \"2026-09-20\",\n  \"paymentMethod\": \"tarjeta\",\n  \"notes\": \"Mercado de Triana\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('expenseId', json.data.id);",
                  "pm.test('Devuelve id', () => pm.expect(json.data.id).to.be.a('string'));"
                ]
              }
            }
          ]
