{
  "name": "exo-archive-api",
  "version": "2.0.0",
  "description": "API REST del catalogo de exoplanetas EXO-ARCHIVE",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
